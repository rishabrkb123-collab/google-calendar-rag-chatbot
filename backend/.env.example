# Google OAuth2 credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Session secret — use any long random string in production
SECRET_KEY=change-me-to-a-long-random-string

# Optional overrides for local development.
# On Render, omit FRONTEND_URL and REDIRECT_URI to let the app derive them from RENDER_EXTERNAL_URL.
# REDIRECT_URI=http://localhost:8000/auth/callback
# FRONTEND_URL=http://localhost:5174

# Ollama configuration
# Recommended cloud model for this project: gpt-oss:20b-cloud
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_CHAT_MODEL=gpt-oss:20b-cloud
# Required for Ollama Cloud.
OLLAMA_API_KEY=

# Optional: force secure session cookies. On Render this defaults to true automatically.
# SESSION_HTTPS_ONLY=true

# RAG sample question files (relative to project root)
RAG_SAMPLE_QUESTIONS_FILE=google_calendar_rag_1000_questions.txt
RAG_ACTION_SAMPLE_DIR=rag_samples

# Optional: override ChromaDB storage path (default: backend/chroma_db/)
# CHROMA_DB_PATH=backend/chroma_db
