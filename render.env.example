# Render deployment env file for google-calendar-rag-chatbot
# Paste these into Render's Environment section or use this file as your source of truth.
# FRONTEND_URL and REDIRECT_URI are intentionally omitted because the app derives them
# automatically from Render's built-in RENDER_EXTERNAL_URL.
# OLLAMA_BASE_URL and OLLAMA_CHAT_MODEL are omitted because the app now defaults to
# Ollama Cloud with gpt-oss:20b-cloud.

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
SECRET_KEY=replace-with-a-long-random-secret
OLLAMA_API_KEY=your-ollama-cloud-api-key
